rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestampOrIso(val) {
      return val is timestamp || (val is string && val.size() >= 1 && val.size() <= 64);
    }

    function isValidLocation(loc) {
      return loc is map
        && loc.keys().hasAll(['lat', 'lng', 'addressDescription', 'communeSection'])
        && loc.keys().hasOnly(['lat', 'lng', 'addressDescription', 'communeSection', 'elevationMeters'])
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
        && loc.addressDescription is string && loc.addressDescription.size() <= 500
        && loc.communeSection is string && loc.communeSection.size() <= 150
        && (!('elevationMeters' in loc) || (loc.elevationMeters is number && loc.elevationMeters >= -500 && loc.elevationMeters <= 10000));
    }

    function isValidIdentificationTraits(traits) {
      return traits is map
        && traits.keys().hasAll(['growthForm', 'leaves', 'flowers'])
        && traits.keys().hasOnly(['growthForm', 'leaves', 'flowers', 'fruits', 'roots'])
        && traits.growthForm is string && traits.growthForm.size() <= 1000
        && traits.leaves is string && traits.leaves.size() <= 1000
        && traits.flowers is string && traits.flowers.size() <= 1000
        && (!('fruits' in traits) || (traits.fruits is string && traits.fruits.size() <= 1000))
        && (!('roots' in traits) || (traits.roots is string && traits.roots.size() <= 1000));
    }

    function isValidTraditionalUses(uses) {
      return uses is map
        && uses.keys().hasAll(['folkRemedies', 'partUsed', 'preparation', 'informantName', 'informantRole', 'hasConsent'])
        && uses.keys().hasOnly(['folkRemedies', 'partUsed', 'preparation', 'informantName', 'informantRole', 'hasConsent'])
        && uses.folkRemedies is list && uses.folkRemedies.size() <= 30 && (uses.folkRemedies.size() == 0 || uses.folkRemedies[0] is string)
        && uses.partUsed is list && uses.partUsed.size() <= 20 && (uses.partUsed.size() == 0 || uses.partUsed[0] is string)
        && uses.preparation is string && uses.preparation.size() <= 2000
        && uses.informantName is string && uses.informantName.size() <= 200
        && uses.informantRole is string && uses.informantRole.size() <= 200
        && uses.hasConsent is bool;
    }

    function isValidDataSource(ds) {
      return ds is map
        && ds.keys().hasAll(['type', 'title', 'surveyor', 'surveyDate'])
        && ds.keys().hasOnly(['type', 'title', 'surveyor', 'surveyorAddress', 'surveyorPhone', 'surveyDate', 'verifiedBy', 'notes'])
        && ds.type in ['research_heritage', 'field_survey_2026', 'community_contribution']
        && ds.title is string && ds.title.size() <= 300
        && ds.surveyor is string && ds.surveyor.size() <= 200
        && (!('surveyorAddress' in ds) || (ds.surveyorAddress is string && ds.surveyorAddress.size() <= 300))
        && (!('surveyorPhone' in ds) || (ds.surveyorPhone is string && ds.surveyorPhone.size() <= 50))
        && ds.surveyDate is string && ds.surveyDate.size() <= 32
        && (!('verifiedBy' in ds) || (ds.verifiedBy is string && ds.verifiedBy.size() <= 200))
        && (!('notes' in ds) || (ds.notes is string && ds.notes.size() <= 1000));
    }

    function isValidPlant(data) {
      return data is map
        && data.keys().hasAll([
          'id', 'vietnameseName', 'scientificName', 'family', 'coverImage', 'photos',
          'shortDescription', 'identificationTraits', 'habitat', 'habitatCategory',
          'location', 'conservationStatus', 'conservationLevel', 'traditionalUses',
          'dataSource', 'status', 'surveyFrequencyCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'vietnameseName', 'otherNames', 'genus', 'species', 'scientificName',
          'family', 'coverImage', 'photos', 'shortDescription', 'identificationTraits',
          'habitat', 'habitatCategory', 'location', 'conservationStatus', 'conservationLevel',
          'traditionalUses', 'dataSource', 'status', 'surveyFrequencyCount', 'trendStatus',
          'occurrenceStatus', 'isDisappeared', 'monitoringLogs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.vietnameseName is string && data.vietnameseName.size() >= 1 && data.vietnameseName.size() <= 200
        && data.scientificName is string && data.scientificName.size() <= 250
        && data.family is string && data.family.size() <= 200
        && (!('genus' in data) || (data.genus is string && data.genus.size() <= 200))
        && (!('species' in data) || (data.species is string && data.species.size() <= 200))
        && (!('otherNames' in data) || (data.otherNames is list && data.otherNames.size() <= 20 && (data.otherNames.size() == 0 || data.otherNames[0] is string)))
        && data.coverImage is string && data.coverImage.size() <= 450000
        && data.photos is list && data.photos.size() <= 20 && (data.photos.size() == 0 || data.photos[0] is map)
        && data.shortDescription is string && data.shortDescription.size() <= 2000
        && isValidIdentificationTraits(data.identificationTraits)
        && data.habitat is string && data.habitat.size() <= 500
        && data.habitatCategory in ['natural_forest', 'planted_forest', 'shrub_grassland', 'sea', 'garden', 'farmland']
        && isValidLocation(data.location)
        && data.conservationStatus in ['Đã ghi nhận', 'Biến mất', 'Điểm mới (Chờ duyệt)']
        && data.conservationLevel in ['safe', 'vulnerable', 'endangered']
        && (!('occurrenceStatus' in data) || data.occurrenceStatus in ['present', 'safe', 'degraded', 'disappeared', 'new'])
        && (!('isDisappeared' in data) || data.isDisappeared is bool)
        && (!('trendStatus' in data) || data.trendStatus in ['stable', 'declining', 'increasing'])
        && isValidTraditionalUses(data.traditionalUses)
        && isValidDataSource(data.dataSource)
        && data.status in ['verified', 'pending']
        && data.surveyFrequencyCount is number && data.surveyFrequencyCount >= 0 && data.surveyFrequencyCount <= 100000
        && (!('monitoringLogs' in data) || (data.monitoringLogs is list && data.monitoringLogs.size() <= 100 && (data.monitoringLogs.size() == 0 || data.monitoringLogs[0] is map)))
        && isValidTimestampOrIso(data.createdAt)
        && isValidTimestampOrIso(data.updatedAt);
    }

    match /plants/{plantId} {
      allow get: if isValidId(plantId) && existing().status in ['verified', 'pending'];
      allow list: if existing().status in ['verified', 'pending'];
      allow create: if isValidId(plantId) && isValidPlant(incoming()) && incoming().id == plantId;
      allow update: if isValidId(plantId) && isValidPlant(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(plantId) && existing().id == plantId;
    }
  }
}
