{
  "entities": {
    "Plant": {
      "title": "Medicinal Plant Survey Point",
      "description": "Medicinal plant species and geospatial survey point in Tam Anh commune.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier, e.g. TA-HERB-001 or TA-HERB-001-LOC2"
        },
        "vietnameseName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Tên cây thuốc (và tên gọi dân gian)"
        },
        "otherNames": {
          "type": "array",
          "description": "Các tên gọi dân gian khác (tối đa 20 mục)"
        },
        "family": {
          "type": "string",
          "maxLength": 200,
          "description": "Họ thực vật"
        },
        "genus": {
          "type": "string",
          "maxLength": 200,
          "description": "Chi thực vật"
        },
        "species": {
          "type": "string",
          "maxLength": 200,
          "description": "Loài thực vật"
        },
        "scientificName": {
          "type": "string",
          "maxLength": 250,
          "description": "Tên khoa học"
        },
        "coverImage": {
          "type": "string",
          "maxLength": 450000,
          "description": "URL hoặc dữ liệu ảnh đại diện đã nén"
        },
        "photos": {
          "type": "array",
          "description": "Danh sách hình ảnh thực địa (tối đa 20 ảnh)"
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 2000,
          "description": "Mô tả tổng quan"
        },
        "identificationTraits": {
          "type": "object",
          "description": "Đặc điểm hình thái nhận biết thực vật học"
        },
        "habitat": {
          "type": "string",
          "maxLength": 500,
          "description": "Mô tả sinh cảnh"
        },
        "habitatCategory": {
          "type": "string",
          "enum": [
            "natural_forest",
            "planted_forest",
            "shrub_grassland",
            "sea",
            "garden",
            "farmland"
          ],
          "description": "Phân loại sinh cảnh (06 nhóm)"
        },
        "location": {
          "type": "object",
          "description": "Tọa độ GPS (lat, lng), mô tả địa chỉ và thôn (15 thôn)"
        },
        "conservationStatus": {
          "type": "string",
          "enum": ["Đã ghi nhận", "Biến mất", "Điểm mới (Chờ duyệt)"],
          "description": "Hiện trạng thực địa chuẩn hóa (03 trạng thái)"
        },
        "conservationLevel": {
          "type": "string",
          "enum": ["safe", "vulnerable", "endangered"],
          "description": "Mức độ bảo tồn tương thích nội bộ"
        },
        "occurrenceStatus": {
          "type": "string",
          "enum": ["present", "safe", "degraded", "disappeared", "new"],
          "description": "Mã trạng thái hiện diện"
        },
        "isDisappeared": {
          "type": "boolean",
          "description": "Cờ đánh dấu điểm đã biến mất"
        },
        "traditionalUses": {
          "type": "object",
          "description": "Tri thức dân gian và bài thuốc lưu truyền"
        },
        "dataSource": {
          "type": "object",
          "description": "Thông tin nguồn dữ liệu & người khảo sát thực địa"
        },
        "status": {
          "type": "string",
          "enum": ["verified", "pending"],
          "description": "Trạng thái kiểm duyệt"
        },
        "surveyFrequencyCount": {
          "type": "number",
          "description": "Tần suất ghi nhận thực tế"
        },
        "trendStatus": {
          "type": "string",
          "enum": ["stable", "declining", "increasing"],
          "description": "Xu hướng biến động"
        },
        "monitoringLogs": {
          "type": "array",
          "description": "Lịch sử các đợt giám sát thực địa"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm tạo bản ghi"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cập nhật bản ghi"
        }
      },
      "required": [
        "id",
        "vietnameseName",
        "scientificName",
        "family",
        "coverImage",
        "photos",
        "shortDescription",
        "identificationTraits",
        "habitat",
        "habitatCategory",
        "location",
        "conservationStatus",
        "conservationLevel",
        "traditionalUses",
        "dataSource",
        "status",
        "surveyFrequencyCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/plants/{plantId}": {
      "schema": { "$ref": "#/entities/Plant" },
      "description": "Medicinal plant survey points and monitoring logs."
    }
  }
}
